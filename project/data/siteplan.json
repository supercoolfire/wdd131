                  {
                    "tag": "div","class":"wireframes",
                    "items": [
                      {"tag":"h3","textContent":"Desktop View"},
                      {"tag":"img","class":"wireframe-desktop-img light","src":"images/wireframe-desktop-light.svg","alt":"Desktop Wireframe","width":"320px"},
                      {"tag":"img","class":"wireframe-desktop-img dark","src":"images/wireframe-desktop-dark.svg","alt":"Desktop Wireframe","width":"320px"},
                      {"tag":"h3","textContent":"Mobile View"},
                      {"tag":"img","class":"wireframe-mobile-img light","src":"images/wireframe-mobile-light.svg","alt":"Mobile Wireframe","width":"320px"},
                      {"tag":"img","class":"wireframe-mobile-img dark","src":"images/wireframe-mobile-dark.svg","alt":"Mobile Wireframe","width":"320px"}
